# Neo4j (local or Aura Free)
NEO4J_URI=neo4j+s://YOUR_INSTANCE.databases.neo4j.io
NEO4J_USER=YOUR_USERNAME
# Aura connection files often use NEO4J_USERNAME — either works
# NEO4J_USERNAME=YOUR_USERNAME
NEO4J_PASSWORD=YOUR_PASSWORD
NEO4J_DATABASE=neo4j

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
LLM_PROVIDER=openai
RAG_EMBEDDING_PROVIDER=openai

# Optional paths (defaults shown)
# CHROMA_PERSIST_DIR=./chroma_db
# MODEL_DIR=./saved_models
# FRONTEND_DIST=./frontend/dist

# Extra CORS origins (comma-separated). Same-origin Azure deploy usually needs none.
# CORS_ORIGINS=https://your-app.azurewebsites.net

# Snowflake (dlt bronze + dbt silver/gold)
SNOWFLAKE_ACCOUNT=YOUR_SNOWFLAKE_ACCOUNT
SNOWFLAKE_USER=YOUR_SNOWFLAKE_USER
SNOWFLAKE_ROLE=ACCOUNTADMIN
SNOWFLAKE_WAREHOUSE=MOC_WH
SNOWFLAKE_DATABASE=MOC_DEV
SNOWFLAKE_BRONZE_SCHEMA=BRONZE
SNOWFLAKE_SILVER_SCHEMA=SILVER
SNOWFLAKE_GOLD_SCHEMA=GOLD
# Prefer password for local scripts, or set authenticator=externalbrowser for SSO
# SNOWFLAKE_PASSWORD=
# SNOWFLAKE_AUTHENTICATOR=externalbrowser
